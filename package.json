{
  "name": "jasonmcalpin-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "yarn optimize-images && vite",
    "build": "yarn verify:content && yarn optimize-images && tsc -b && vite build && node scripts/generate-static-pages.mjs && yarn verify:static && yarn verify:chunks && yarn verify:no-motion && yarn verify:svg-layout && cp .htaccess dist/ --f",
    "verify:static": "node scripts/verify-static-pages.mjs",
    "verify:content": "node scripts/verify-json-content.mjs",
    "verify:chunks": "node scripts/verify-home-chunks.mjs",
    "verify:no-motion": "node scripts/verify-no-motion.mjs",
    "verify:svg-layout": "node scripts/verify-svg-and-layout.mjs",
    "build:analyze": "yarn build && open dist/stats.html",
    "optimize-images": "node scripts/optimize-images.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "security-check": "yarn audit --level moderate",
    "security-fix": "yarn audit",
    "type-check": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/dom": "^10.4.1",
    "@unhead/react": "^2.0.13",
    "lucide-react": "^0.546.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-gtm-module": "^2.0.11",
    "react-i": "^0.2.1",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.7.0",
    "react-swipeable": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/react-gtm-module": "^2.0.4",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "cpy": "^11.1.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.3.0",
    "happy-dom": "^20.0.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "prettier": "3.6.2",
    "rollup": "^4.46.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "sharp": "^0.34.4",
    "terser": "^5.43.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-compression2": "^2.3.0",
    "vitest": "^3.2.4"
  }
}
